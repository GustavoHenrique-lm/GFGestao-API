<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>GF Gestões - @ViewData["Title"]</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f5f5f7;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            background-color: #5b21b6;
            color: white;
            padding: 25px 15px;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 35px;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .menu a {
            color: white;
            text-decoration: none;
            padding: 13px 15px;
            border-radius: 8px;
            display: block;
        }

        .menu a:hover {
            background-color: #7c3aed;
        }

        .content {
            flex: 1;
            padding: 30px;
        }

        .topbar {
            background-color: white;
            padding: 18px 25px;
            border-radius: 12px;
            margin-bottom: 25px;
        }
    </style>
</head>

<body>

    <div class="layout">

        <aside class="sidebar">

            <div class="logo">
                GF Gestões
            </div>

            <nav class="menu">

                <a href="/Admin">
                    Dashboard
                </a>

                <a href="/AdminTarefas">
                    Tarefas
                </a>

                <a asp-controller="AdminUsuarios"
                    asp-action="Index">
                        Usuários
                </a>

                <a asp-controller="Relatorios"
                    asp-action="Index">
                        Relatórios
                </a>

                <form asp-controller="AdminLogin"
                        asp-action="Logout"
                        method="post"
                        style="margin: 0;">

                        <button type="submit"
                                style="
                                    width: 100%;
                                    background: none;
                                    border: none;
                                    color: white;
                                    text-align: left;
                                    padding: 13px 15px;
                                    border-radius: 8px;
                                    cursor: pointer;
                                    font-size: 16px;
                                ">
                            Sair
                        </button>

                    </form>

            </nav>

        </aside>

        <main class="content">

            <div class="topbar">
                <strong>
                    @ViewData["Title"]
                </strong>
            </div>

            @RenderBody()

        </main>

    </div>

</body>
</html>